# Razorpay test-mode credentials (Settings -> API Keys in the Razorpay Dashboard, Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the Groq model used by the shared wrapper
GROQ_MODEL=openai/gpt-oss-120b

# Postgres connection. Supabase is the canonical store — grab the URI from
# Project Settings -> Database -> Connection string and insert "+psycopg2"
# after the scheme. Note the database name is "postgres", not "solvent".
#
# The direct host (db.<ref>.supabase.co:5432) is IPv6-only. If you deploy
# somewhere without IPv6 egress (common on Docker/Railway), use the pooler
# host instead: aws-0-<region>.pooler.supabase.com:6543
DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Local Postgres alternative (see README for setup commands) — useful as a
# fallback, since Supabase free-tier projects pause after 7 days idle.
# DATABASE_URL=postgresql+psycopg2://solvent:solvent_dev_pw@localhost:5432/solvent

# Comma-separated frontend origins allowed to call this API (CORS). In
# production, set this to the deployed Vercel URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000
